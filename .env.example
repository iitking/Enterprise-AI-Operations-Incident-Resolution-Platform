# OpsPilot AI Configuration
# Author: Nivesh Kumar Meena
# Copyright (c) 2026 Nivesh Kumar Meena. All Rights Reserved.

# Application
APP_NAME="OpsPilot AI"
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
DEBUG=true
PROJECT_AUTHOR="Nivesh Kumar Meena"

# Security & Authentication
JWT_SECRET_KEY=opspilot_super_secret_jwt_key_nivesh_kumar_meena_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
API_KEY_HEADER=X-OpsPilot-API-Key
DEFAULT_ADMIN_EMAIL=admin@opspilot.ai
DEFAULT_ADMIN_PASSWORD=admin_secret_pass

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://opspilot:opspilot_pass@localhost:5432/opspilot_db
# For SQLite in-memory / local fallback testing:
# DATABASE_URL=sqlite:///./opspilot.db

# Redis Cache & Message Broker
REDIS_URL=redis://localhost:6379/0

# LLM & OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview
EMBEDDING_MODEL=text-embedding-3-small
LLM_TEMPERATURE=0.1

# LangSmith Observability & Evaluation
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=opspilot-ai-production

# n8n Automation Workflows
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_INCIDENT_TRIGGER=http://localhost:5678/webhook/incident-trigger
N8N_WEBHOOK_APPROVAL=http://localhost:5678/webhook/approval-decision
N8N_WEBHOOK_REMEDIATION=http://localhost:5678/webhook/execute-remediation

# Integrations
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/mock/token
SLACK_CHANNEL=#incidents-prod
JIRA_BASE_URL=https://company.atlassian.net
JIRA_API_TOKEN=mock_jira_token
JIRA_PROJECT_KEY=OPS

# Infrastructure & Observability
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000
KUBERNETES_NAMESPACE=production
